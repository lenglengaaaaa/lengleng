/**app.wxss 全局样式**/
page {
  height: 100vh;
  background: #f5f6fa;
  color: #1f2329;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
scroll-view,
button {
  box-sizing: border-box;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}
