.page{height:100%;background:#f5f6fa}.body{height:calc(100vh - 128rpx)}.wrap{padding:28rpx 32rpx 0}.hero{padding:34rpx 30rpx 28rpx;border-radius:30rpx;background:linear-gradient(135deg,#202a4a,#516cf2);color:#fff;box-shadow:0 18rpx 40rpx rgba(43,63,140,.18)}.hero-head{display:flex;justify-content:space-between}.eyebrow{display:block;font-size:20rpx;letter-spacing:3rpx;opacity:.72}.hero-title{display:block;margin-top:12rpx;font-size:42rpx;font-weight:700}.hero-sub{display:block;margin-top:12rpx;font-size:24rpx;line-height:1.6;opacity:.8}.hero-mark{font-size:62rpx;opacity:.8}.primary{margin:30rpx 0 0;border:0;border-radius:18rpx;background:#fff;color:#344fc5;font-size:28rpx;font-weight:600}.privacy{display:block;margin-top:18rpx;text-align:center;font-size:20rpx;opacity:.68}.metrics{display:flex;margin:24rpx 0; padding:26rpx 10rpx;background:#fff;border-radius:24rpx;box-shadow:0 8rpx 25rpx rgba(35,42,65,.04)}.metrics>view{flex:1;text-align:center;border-right:1rpx solid #edf0f5}.metrics>view:last-child{border:0}.metric-v,.metric-l{display:block}.metric-v{font-size:34rpx;font-weight:700;color:#222b45}.metric-l{margin-top:6rpx;font-size:21rpx;color:#8b94a6}.section{margin-top:30rpx}.section-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx}.section-title{font-size:30rpx;font-weight:700}.section-link{font-size:23rpx;color:#536cf0}.task-card{display:flex;align-items:center;margin-bottom:14rpx;padding:24rpx;background:#fff;border-radius:22rpx}.task-icon{width:70rpx;height:70rpx;line-height:70rpx;margin-right:20rpx;border-radius:18rpx;text-align:center;font-size:36rpx;color:#6d4ce8;background:#f0ebff}.task-icon.blue{color:#3d6cf4;background:#e9efff}.task-title,.task-sub{display:block}.task-title{font-size:28rpx;font-weight:600}.task-sub{margin-top:5rpx;font-size:22rpx;color:#939aaa}.task-arrow{font-size:40rpx;color:#bbc1cc}.photo-strip{white-space:nowrap}.thumb-wrap{position:relative;display:inline-block;width:180rpx;height:180rpx;margin-right:14rpx}.thumb{width:180rpx;height:180rpx;border-radius:18rpx;background:#e8ebf3}.thumb-status{position:absolute;left:10rpx;bottom:10rpx;padding:5rpx 10rpx;border-radius:8rpx;font-size:18rpx;background:rgba(255,255,255,.9)}.notice{margin:30rpx 0 18rpx;padding:20rpx 22rpx;border-radius:16rpx;background:#eef3ff;color:#647198;font-size:22rpx;line-height:1.6}.danger-link{text-align:center;color:#b16c6c;font-size:22rpx}.safe-space{height:70rpx}

