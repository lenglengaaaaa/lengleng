ius:30rpx 30rpx 0 0;background:#f5f6fa}.sheet-head{display:flex;justify-content:space-between}.sheet-title{display:block;font-size:31rpx;font-weight:700}.sheet-sub{display:block;margin-top:8rpx;color:#8d96a7;font-size:21rpx}.sheet-close{font-size:46rpx;color:#8d96a7}.sheet-scroll{max-height:64vh;margin-top:20rpx}.review-card{display:flex;align-items:center;margin:14rpx 0;padding:14rpx;background:#fff;border-radius:18rpx}.review-image{width:138rpx;height:138rpx;border-radius:12rpx;background:#e9ecf3}.review-info{flex:1;min-width:0;padding:0 16rpx}.review-name,.review-meta,.score,.badge{display:block}.review-name{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:24rpx;font-weight:600}.review-meta,.score{margin-top:5rpx;color:#8e96a6;font-size:19rpx}.badge{width:max-content;margin-top:8rpx;padding:4rpx 9rpx;border-radius:7rpx;font-size:18rpx}.keep-button{width:100rpx;margin:0;padding:0;border-radius:12rpx;background:#eef2ff;color:#4f68e7;font-size:22rpx}.keep-button:after{border:0}
