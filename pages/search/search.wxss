.page{height:100%;background:#f5f6fa}.top{padding:24rpx 32rpx 18rpx;background:#fff}.search-box{display:flex;align-items:center;height:76rpx;padding:0 20rpx;border-radius:18rpx;background:#f4f5f8}.search-icon{font-size:34rpx;color:#7c8596}.search-input{flex:1;margin-left:12rpx;font-size:25rpx}.clear{font-size:34rpx;color:#9aa2b1}.map-head{display:flex;justify-content:space-between;align-items:flex-start;margin-top:20rpx}.map-title,.map-sub{display:block}.map-title{font-size:24rpx;font-weight:700}.map-sub{width:390rpx;margin-top:7rpx;color:#8d96a7;font-size:19rpx;line-height:1.45}.column-controls{display:flex;padding:4rpx;border-radius:12rpx;background:#f1f3f8}.column-button{padding:8rpx 10rpx;border-radius:9rpx;color:#7c8494;font-size:19rpx}.column-button.active{background:#fff;color:#4f68e7;font-weight:700;box-shadow:0 2rpx 8rpx rgba(36,45,77,.1)}.batch-scroll{margin-top:18rpx;white-space:nowrap}.batch-list{display:inline-flex;align-items:center}.batch-button{margin-right:12rpx;padding:12rpx 16rpx;border:1rpx solid #e4e7ef;border-radius:14rpx;background:#fff;color:#70798a;font-size:20rpx}.batch-button.active{border-color:#546de8;background:#eef2ff;color:#455fd6;font-weight:700}.selection-tip{margin-top:18rpx;padding:16rpx 18rpx;border-radius:14rpx;background:#eef2ff;color:#53658f;font-size:20rpx;line-height:1.55}.body{height:calc(100vh - 500rpx)}.grid{display:flex;flex-wrap:wrap;align-items:flex-start;padding:22rpx 24rpx}.map-card{box-sizing:border-box;margin-bottom:22rpx}.cols-3 .map-card{width:32%;margin-right:2%}.cols-3 .map-card:nth-child(3n){margin-right:0}.cols-4 .map-card{width:23.5%;margin-right:2%}.cols-4 .map-card:nth-child(4n){margin-right:0}.cols-5 .map-card{width:18.4%;margin-right:2%}.cols-5 .map-card:nth-child(5n){margin-right:0}.image-wrap{position:relative;border:3rpx solid transparent;border-radius:15rpx;background:#e8ebf3;overflow:hidden}.map-card.map-keep .image-wrap{border-color:#31a96e}.map-card.map-remove .image-wrap{border-color:#e26161}.photo{display:block;width:100%;height:190rpx;background:#e8ebf3}.cols-3 .photo{height:250rpx}.cols-5 .photo{height:145rpx}.sequence{position:absolute;top:7rpx;left:7rpx;min-width:32rpx;padding:3rpx 5rpx;border-radius:7rpx;background:rgba(26,32,49,.75);color:#fff;font-size:18rpx;text-align:center}.suggestion{position:absolute;right:5rpx;bottom:5rpx;padding:4rpx 6rpx;border-radius:7rpx;color:#fff;font-size:17rpx}.suggestion.keep{background:rgba(22,138,82,.93)}.suggestion.remove{background:rgba(209,67,67,.93)}.location,.photo-meta,.group-link{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.location{margin-top:9rpx;color:#4b5260;font-size:18rpx}.photo-meta{margin-top:4rpx;color:#969eac;font-size:16rpx}.group-link{margin-top:5rpx;color:#4f68e7;font-size:17rpx}.empty{width:100%;padding:150rpx 20rpx;text-align:center}.empty-title,.empty-sub{display:block}.empty-title{font-size:30rpx;font-weight:700}.empty-sub{margin-top:8rpx;color:#929aaa;font-size:22rpx;line-height:1.6}.safe-space{height:70rpx}